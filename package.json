{
  "name": "flywise-flight-delay-intelligence",
  "version": "1.0.0",
  "description": "Flight delay prediction and analytics platform for airline operations staff",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "build": "cross-env NODE_ENV=production vite build",
    "start": "tsx src/server.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "db:status": "tsx db/runner.ts status",
    "db:migrate": "tsx db/runner.ts migrate",
    "db:verify": "tsx db/runner.ts verify",
    "etl": "tsx src/etl/load-flights.ts",
    "etl:aggregates": "tsx src/etl/refresh-aggregates.ts"
  },
  "keywords": [
    "flight",
    "delay",
    "prediction",
    "analytics",
    "airline",
    "operations"
  ],
  "author": "Group 12 - INF2006",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "3.24.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.7.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "nodemon": "^3.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.4",
    "vite": "^5.2.8",
    "vitest": "^1.4.0"
  }
}
