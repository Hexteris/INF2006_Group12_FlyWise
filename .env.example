# FlyWise environment variables.
# Copy to .env and adjust. Every key here is required and read by real code;
# src/config/env.ts validates them and refuses to start if one is missing.
#
# Only needed to run the server directly (npm run dev / npm start).
# docker compose supplies these itself, so the compose stack needs no .env.

# Database. DB_HOST is 'localhost' when running the server on the host against
# the compose MySQL, or 'mysql' from inside the compose network.
#
# DB_PORT is 3307 because docker-compose.yml publishes MySQL on 3307. A natively
# installed MySQL/MariaDB service commonly already owns 3306, and if it does, the
# host port answers from the wrong server - which shows up as a confusing auth
# error rather than a connection failure.
DB_HOST=localhost
DB_PORT=3307
DB_USER=flywise
DB_PASSWORD=flywise123
DB_NAME=flywise
# Must be exactly true or false. Deliberately has no default: TLS silently
# defaulting to off is how a cloud deployment ends up unencrypted.
DB_SSL=false

# Server
PORT=8000
NODE_ENV=development
